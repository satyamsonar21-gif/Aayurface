flowchart TD
    subgraph Untrusted["Untrusted Public Internet"]
        Client["Browser Client / Mobile SPA"]
    end

    subgraph Perimeter["Perimeter Security Boundary"]
        TLS["TLS 1.3 / HTTPS"]
        CORS["Strict CORS Whitelist"]
        Rate["Sliding-Window Rate Limiter"]
    end

    subgraph Gateway["Authenticated Gateway Boundary"]
        JWT["RS256 JWT Verification"]
        Identity["Server-Derived auth.uid()"]
        AntiBOLA["Anti-BOLA Path Check"]
        Zod["Zod Input Validation"]
    end

    subgraph Internal["Internal Trusted Zone"]
        App["Domain Services"]
        Workers["Asynchronous AI Workers"]
        DB[("PostgreSQL Kernel RLS")]
        S3[("Private S3 (No Public Access)")]
    end

    Client --> TLS
    TLS --> CORS
    CORS --> Rate
    Rate --> JWT
    JWT --> Identity
    Identity --> AntiBOLA
    AntiBOLA --> Zod
    Zod --> App
    Zod --> Workers
    App --> DB
    Workers --> DB
    Workers --> S3
