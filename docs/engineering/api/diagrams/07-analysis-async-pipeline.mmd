sequenceDiagram
    autonumber
    actor Client as Client App
    participant GW as Edge Gateway
    participant Queue as PostgreSQL (analysis_jobs)
    participant Worker as Background AI Worker
    participant DB as PostgreSQL (Results Tables)

    Client->>GW: POST /api/v1/analyses (captureSessionId, Idempotency-Key)
    GW->>Queue: INSERT INTO analysis_jobs (status: 'QUEUED')
    GW-->>Client: 202 Accepted ({ jobId, statusUrl, retryAfter: 2s })

    Worker->>Queue: Claim Job (UPDATE ... FOR UPDATE SKIP LOCKED)
    Queue-->>Worker: Acquired Job Row (Status: VALIDATING)
    
    loop Status Polling
        Client->>GW: GET /api/v1/analyses/:id/status
        GW->>Queue: SELECT status, stage FROM analysis_jobs
        GW-->>Client: 200 OK ({ status: 'FUSION_PROCESSING', stage: 6 })
    end

    Worker->>Worker: Complete Pipeline (CV, Fusion, RAG, LLM, Safety)
    Worker->>DB: Atomic 3NF Insert (scan_results, fusions, recommendations)
    Worker->>Queue: UPDATE analysis_jobs SET status = 'COMPLETED'
    
    Client->>GW: GET /api/v1/analyses/:id/status
    GW-->>Client: 200 OK ({ status: 'COMPLETED', isTerminal: true })
    Client->>GW: GET /api/v1/analyses/:id
    GW->>DB: SELECT * FROM scan_results WHERE id = :id AND user_id = auth.uid()
    DB-->>GW: Result Snapshot
    GW-->>Client: 200 OK ({ data: scanResult })
