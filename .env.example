# Aayurface — Environment Variables
# Copy this file to .env.local and fill in your credentials

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Note: OPENAI_API_KEY is configured in Supabase Edge Function secrets
# Run: supabase secrets set OPENAI_API_KEY=sk-your-key
